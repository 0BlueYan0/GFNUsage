{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GFNUsage",
  "identifier": "tw.iosclub.gfnusage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GFNUsage",
        "width": 360,
        "height": 480,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "label": "main",
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "0BlueYan0",
    "copyright": "Copyright 2026 0BlueYan0",
    "shortDescription": "GeForce NOW 月配額監控",
    "homepage": "https://github.com/0BlueYan0/GFNUsage",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "TradChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMkE3QTM1MDNCM0ExM0UKUldRK29iTUROWG9xOHVjdDI5cFd3YVRIL1pSSUF4UTRDZ09Xa2I3T0dMUWljb2ExZFBWRTV4N0QK",
      "endpoints": [
        "https://github.com/0BlueYan0/GFNUsage/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
